<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Nexus Gaming Network | Premium PvP Portal</title>
  <style>
    /* 🌌 DEEP SPACE GLOW DESIGN PARAMETERS */
    :root {
      --space-black: #060813;
      --card-gray: rgba(17, 24, 39, 0.75);
      --neon-blue: #00f2ff;
      --neon-pink: #ff007f;
      --neon-green: #39ff14;
      --text-white: #f8fafc;
      --text-muted: #64748b;
    }

    body {
      background-color: var(--space-black);
      color: var(--text-white);
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      margin: 0; padding: 0;
      overflow-x: hidden;
    }

    /* 🛸 GLOWING HEADER NAVIGATION PLATFORM */
    header {
      background: rgba(10, 15, 30, 0.85);
      backdrop-filter: blur(12px);
      padding: 20px 40px;
      display: flex; justify-content: space-between; align-items: center;
      border-bottom: 1px solid rgba(0, 242, 255, 0.15);
      position: sticky; top: 0; z-index: 100;
    }
    .brand-logo {
      font-size: 24px; font-weight: 900;
      background: linear-gradient(90deg, var(--neon-blue), var(--neon-pink));
      -webkit-background-clip: text; -webkit-text-fill-color: transparent;
      letter-spacing: 2px;
    }
    .nav-menu { display: flex; gap: 25px; }
    .nav-menu a {
      color: #94a3b8; text-decoration: none; font-weight: bold;
      font-size: 14px; letter-spacing: 1px; transition: 0.3s;
    }
    .nav-menu a:hover { color: var(--neon-blue); text-shadow: 0 0 8px var(--neon-blue); }

    /* ⚡ CYBERPUNK HERO DISPLAY CORNER */
    .hero-panel {
      text-align: center; padding: 80px 20px;
      background: radial-gradient(circle at center, rgba(124, 58, 237, 0.1) 0%, transparent 70%);
      position: relative;
    }
    .live-tracker {
      display: inline-flex; align-items: center; gap: 10px;
      background: rgba(57, 255, 20, 0.08); border: 1px solid var(--neon-green);
      color: #a3e635; padding: 10px 24px; border-radius: 30px;
      font-size: 13px; font-weight: bold; letter-spacing: 1px;
      box-shadow: 0 0 15px rgba(57, 255, 20, 0.15);
    }
    .pulse-core {
      width: 10px; height: 10px; background: var(--neon-green);
      border-radius: 50%; animation: radialPulse 2s infinite;
    }
    @keyframes radialPulse {
      0% { box-shadow: 0 0 0 0 rgba(57, 255, 20, 0.7); }
      70% { box-shadow: 0 0 0 10px rgba(57, 255, 20, 0); }
      100% { box-shadow: 0 0 0 0 rgba(57, 255, 20, 0); }
    }
    
    h1 { font-size: 46px; font-weight: 900; margin: 25px 0 10px 0; letter-spacing: -1px; }
    .subtitle { color: var(--text-muted); font-size: 16px; max-width: 500px; margin: 0 auto 30px auto; }
    
    /* 🏷️ SERVER CONNECTION CONTAINER TERMINAL */
    .ip-plate {
      background: rgba(15, 23, 42, 0.6); padding: 14px 28px;
      border-radius: 12px; font-family: monospace; color: var(--neon-blue);
      border: 1px solid rgba(0, 242, 255, 0.25); display: inline-block;
      font-size: 16px; cursor: pointer; transition: 0.3s;
    }
    .ip-plate:hover { background: rgba(0, 242, 255, 0.08); box-shadow: 0 0 20px rgba(0, 242, 255, 0.2); }

    /* 📊 PROFESSIONAL ARCADES GRID PROFILE */
    .dashboard-grid {
      display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: 25px; max-width: 1100px; margin: 20px auto 60px auto; padding: 0 20px;
    }
    .arcade-card {
      background: var(--card-gray); border-radius: 16px; padding: 30px;
      border: 1px solid rgba(255, 255, 255, 0.05); backdrop-filter: blur(10px);
      transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .arcade-card:hover {
      transform: translateY(-5px);
      border-color: var(--neon-pink);
      box-shadow: 0 10px 30px rgba(255, 0, 127, 0.1);
    }
    .arcade-card h3 { margin: 0 0 12px 0; font-size: 22px; color: #fff; letter-spacing: 0.5px; }
    .arcade-card p { color: #94a3b8; font-size: 14px; line-height: 1.6; margin-bottom: 25px; }
    
    .action-link {
      display: block; text-align: center; background: linear-gradient(90deg, #1d4ed8, #4f46e5);
      color: #fff; padding: 12px; border-radius: 8px; text-decoration: none;
      font-weight: bold; font-size: 14px; transition: 0.3s;
    }
    .action-link:hover { background: linear-gradient(90deg, #2563eb, #6366f1); box-shadow: 0 4px 15px rgba(37, 99, 235, 0.4); }
  </style>
</head>
<body>

  <!-- Navigation Frame -->
  <header>
    <div class="brand-logo">NEXUS.NET</div>
    <div class="nav-menu">
      <a href="#modes">Battle Arenas</a>
      <a href="#stats">Global Boards</a>
      <a href="#store">Lobby Shop</a>
    </div>
  </header>

  <!-- Interactive Network Display Screen -->
  <div class="hero-panel">
    <div class="live-tracker">
      <span class="pulse-core"></span> SYSTEM ACTIVE: <span id="playerCount">1,840</span> COMBATANTS ONLINE
    </div>
    <h1>Dominate the Arena Grid</h1>
    <p class="subtitle">Connect straight from your network configuration portal into the ultimate action matrix database.</p>
    
    <!-- Tap to Copy Option Block -->
    <div class="ip-plate" onclick="copyServerIP()">IP: PLAY.NEXUSNETWORK.NET</div>
  </div>

  <!-- Arena Module List -->
  <div id="modes" class="dashboard-grid">
    <div class="arcade-card">
      <h3>⚔️ Chrono GenWars</h3>
      <p>Construct complex core generators, mine automated resource currencies, fortify protective parameters, and scale custom server ladder updates alongside your squad unit lines.</p>
      <a href="#" class="action-link">View Squad Positions</a>
    </div>
    
    <div class="arcade-card">
      <h3>🌌 Hyper SMP Kingdoms</h3>
      <p>Claim dynamic space grids, manage custom trades, manufacture automated inventory production factories, and acquire rare aesthetic matrix gear packs.</p>
      <a href="#" class="action-link">Browse Explorer Files</a>
    </div>
  </div>

  <script>
    // 🕹️ LIVE REFRESH LOOP: Randomly changes online count to simulate real gaming network tracking
    setInterval(() => {
      const baseCount = 1800;
      const variation = Math.floor(Math.random() * 60);
      document.getElementById('playerCount').innerText = (baseCount + variation).toLocaleString();
    }, 4000);

    // 📋 UTILITY: Quick tap notification profile to alert copy action success
    function copyServerIP() {
      navigator.clipboard.writeText("play.nexusnetwork.net");
      alert("Server IP address copied into memory buffer! Ready for login console deployment.");
    }
  </script>

</body>
</html>
